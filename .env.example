# Copiez ce fichier en .env et ajustez si besoin. .env n'est jamais commité (voir .gitignore).

FLASK_ENV=development
SECRET_KEY=change-moi

# DATABASE_URL reste commenté exprès : sans variable d'environnement,
# config.py utilise déjà un chemin absolu (racine du projet/academie.db).
# Si vous décommentez la ligne ci-dessous avec un chemin RELATIF comme
# "sqlite:///academie.db", Flask-SQLAlchemy le résout par rapport au
# dossier instance/ de Flask, pas à la racine du projet — et vous vous
# retrouvez avec deux fichiers .db différents selon que cette variable est
# définie ou non (celui que seed.py peuple n'est plus forcément celui que
# le serveur lit). Si vous voulez vraiment personnaliser l'emplacement,
# utilisez un chemin absolu.
# DATABASE_URL=sqlite:///academie.db

# Passez à True pour activer le log SQL (utile jour 2 pour la chasse au N+1).
SQLALCHEMY_ECHO=False

# Niveau du logger applicatif (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Passez à True pour écrire aussi les logs dans logs/app.log (rotation à
# 1 Mo, 3 fichiers conservés), en plus de la console.
LOG_TO_FILE=False
